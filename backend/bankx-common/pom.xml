<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ======================================================================
         BankX Common — Shared library dùng chung cho mọi module
         Chứa: ApiResponse, ErrorCode, Exceptions, Utilities (MaskingUtils...)
         KHÔNG chứa Spring Web/Security — chỉ là thư viện thuần
         ====================================================================== -->

    <parent>
        <groupId>com.bankx</groupId>
        <artifactId>bankx-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>bankx-common</artifactId>
    <packaging>jar</packaging>
    <name>BankX Common</name>
    <description>Shared utilities, DTOs, Exceptions dùng chung trong BankX</description>

    <dependencies>
        <!-- Jackson — Serialize/Deserialize JSON -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Validation API — @NotNull, @Valid, @Size... -->
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
    </dependencies>

    <!-- Common là pure Java library, không cần spring-boot-maven-plugin -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
