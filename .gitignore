# ==============================================================================
# BankX .gitignore
# ==============================================================================

# ========== Java / Maven ==========
target/
*.jar
*.war
*.class
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ========== Spring Boot ==========
application-local.yml
application-secret.yml
*.p12
*.jks

# ========== IntelliJ IDEA ==========
.idea/
*.iws
*.iml
*.ipr
out/

# ========== VS Code ==========
.vscode/
!.vscode/extensions.json
!.vscode/settings.json

# ========== Angular / Node ==========
node_modules/
dist/
.angular/cache/
.sass-cache/
*.js.map
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml

# ========== Docker ==========
# Không ignore docker-compose.yml — cần commit
# Nhưng ignore override files (local customization)
docker-compose.override.yml

# ========== Secrets — TUYỆT ĐỐI KHÔNG COMMIT ==========
.env
.env.local
.env.*.local
*.pem
*.key
*_rsa
*_rsa.pub

# ========== OS ==========
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
